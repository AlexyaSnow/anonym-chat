# === TikRec — configuration ===

# Token du bot Telegram (obtenu via @BotFather). OBLIGATOIRE.
BOT_TOKEN=123456:ABC-DEF_your_token_here

# IDs Telegram autorisés à piloter le bot, séparés par des virgules.
# Laisser vide = tout le monde peut l'utiliser. Pour trouver ton ID : @userinfobot
ALLOWED_USERS=

# Dossier où sont écrits les enregistrements .mp4
OUTPUT_DIR=./recordings

# Intervalle (secondes) entre deux vérifications de l'état "en live" des pseudos surveillés
CHECK_INTERVAL=60

# Cookie sessionid TikTok (optionnel). Améliore la fiabilité et permet
# d'accéder aux lives soumis à une restriction régionale / d'âge.
TIKTOK_SESSIONID=

# Taille max (Mo) d'un fichier renvoyé directement dans le chat Telegram.
# Au-delà, le bot envoie seulement une notification avec le chemin du fichier.
# (Limite officielle de l'API Bot : 50 Mo)
TELEGRAM_UPLOAD_LIMIT_MB=49
